# Server environment variables
PORT=5000
NODE_ENV=development
JWT_SECRET=supersecret_jwt_key_lifevault_change_in_production
DB_PATH=./server/lifevault.db
UPLOAD_DIR=./server/uploads
REMINDER_DAYS_WINDOW=30

# Optional Email Notification Configuration (Leave blank if not used)
# If provided, LifeVault attempts to dispatch email reminders via nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LifeVault Reminders <reminders@lifevault.test>
